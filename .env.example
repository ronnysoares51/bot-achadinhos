# ===== Telegram (obrigatório: é o painel do bot) =====
TELEGRAM_BOT_TOKEN=
# Seu ID de usuário (mande /start ao bot para descobrir). Vários: separe por vírgula.
TELEGRAM_ADMINS=
# Canais/grupos onde as ofertas são publicadas (o bot precisa ser admin). Ex.: @meucanal,-1001234567890
TELEGRAM_CANAIS=

# ===== WhatsApp (opcional, biblioteca não oficial: risco de banimento) =====
WHATSAPP_ATIVO=false
# IDs (xxx@g.us) ou nomes exatos dos grupos. Use /grupos no Telegram para ver os IDs.
WHATSAPP_GRUPOS=
WHATSAPP_PAUSA_MIN=20
WHATSAPP_PAUSA_MAX=60

# ===== Shopee (API oficial de afiliados) =====
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_SUB_ID=achadinhos

# ===== Mercado Livre =====
# Opcional: só para converter links comuns. Links meli.la funcionam sem isso.
ML_MATT_WORD=
ML_MATT_TOOL=

# ===== Shein =====
# Opcional: parâmetros extras para acrescentar ao link (ex.: url_from=SEU_ID). Vazio = usa o link colado.
SHEIN_PARAMETROS=

# ===== Agendamento da fila =====
POST_INTERVALO_MIN=45
POST_HORA_INICIO=8
POST_HORA_FIM=22
POST_MAX_DIA=8
TZ=America/Sao_Paulo

# ===== Busca automática na Shopee =====
AUTO_SHOPEE=false
AUTO_SHOPEE_PALAVRAS=fone bluetooth,air fryer,organizador
AUTO_SHOPEE_DESCONTO_MIN=30
AUTO_SHOPEE_NOTA_MIN=4.5
AUTO_SHOPEE_INTERVALO_H=3

PASTA_DADOS=dados
